{
  "name": "consulting-math-drill-tool",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first consulting interview preparation web application.",
  "scripts": {
    "authoring:check": "node scripts/sync-question-pack-authoring-kit.mjs --check",
    "authoring:sync": "node scripts/sync-question-pack-authoring-kit.mjs",
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/serve-web-build.mjs",
    "check": "npm run authoring:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run e2e",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "^16.2.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.7",
    "jsdom": "25.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
