{
  "name": "consulting-math-drill-tool",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.19.0 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0 <12",
      "onFail": "error"
    }
  },
  "license": "MIT",
  "description": "Local-first consulting interview preparation web application.",
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "predev": "node scripts/check-runtime.mjs",
    "prebuild": "node scripts/check-runtime.mjs",
    "prepreview": "node scripts/check-runtime.mjs",
    "precheck": "node scripts/check-runtime.mjs",
    "prelint": "node scripts/check-runtime.mjs",
    "pretypecheck": "node scripts/check-runtime.mjs",
    "pretest": "node scripts/check-runtime.mjs",
    "pree2e": "node scripts/check-runtime.mjs",
    "pree2e:cross-browser": "node scripts/check-runtime.mjs",
    "prerelease:artifact": "node scripts/check-runtime.mjs",
    "authoring:check": "node scripts/sync-question-pack-authoring-kit.mjs --check",
    "authoring:sync": "node scripts/sync-question-pack-authoring-kit.mjs",
    "catalog:check": "node scripts/sync-community-pack-catalog.mjs --check",
    "catalog:sync": "node scripts/sync-community-pack-catalog.mjs",
    "version:check": "node scripts/check-version-contract.mts",
    "actions:check": "node scripts/check-action-pins.mjs",
    "i18n:check": "node scripts/sync-i18n-locales.mjs --check",
    "i18n:sync": "node scripts/sync-i18n-locales.mjs",
    "clean:web": "node scripts/prepare-web-build.mjs clean",
    "dev": "next dev",
    "build": "npm run clean:web && npm run catalog:check && npm run i18n:check && next build && node scripts/finalize-web-build.mjs worker && npm run perf:check && node scripts/finalize-web-build.mjs finalize",
    "perf:check": "node scripts/check-performance-budgets.mjs",
    "preview": "node scripts/serve-web-build.mjs",
    "postdeploy:check": "node scripts/post-deployment-smoke.mts",
    "vercel:prepare": "node scripts/prepare-vercel-deployment.mts",
    "release:artifact": "npm run check && node scripts/package-release.mjs",
    "check": "npm run version:check && npm run actions:check && npm run authoring:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run e2e",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=chromium",
    "e2e:cross-browser": "playwright test --grep @browser-smoke --project=firefox-smoke --project=webkit-smoke --project=backup-portability-firefox --project=backup-portability-webkit"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "next": "^16.3.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.6.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.8",
    "jsdom": "25.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  }
}
